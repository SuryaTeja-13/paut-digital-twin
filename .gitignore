# Everything meaningful is tracked (code, data/raw, data/processed, checkpoints,
# docs). Only auto-generated junk is excluded below.

# build artifact (a zip of the repo itself — regenerable)
paut-digital-twin.zip

# PPT decks + their build assets are personal deliverables (kept in Downloads), not repo content
ppt_build/
*.pptx

# python bytecode / envs
__pycache__/
*.pyc
.venv/
venv/
.env
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/

# scratch / temp
scratch_*.py

# transient, regenerable outputs (only the _summary.csv aggregate is tracked)
data/processed/xai/*.json
data/processed/xai_overlays/

# PPT build tooling — personal-deliverable generators, kept local (decks live in Downloads)
scripts/build_student*_pptx.py
scripts/_inspect_pptx.py
